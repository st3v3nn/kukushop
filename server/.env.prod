# Production environment for server
# DO NOT COMMIT this file with real secrets.
NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# Postgres URL
# Example: postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://speedy_admin:REPLACE_PASSWORD@127.0.0.1:5432/speedy_bites

# Security
TOKEN_SECRET=replace_with_a_very_long_random_string_min_32_chars

# Optional MPESA settings
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_BASE=

# CORS allowed origins (comma separated)
CORS_ORIGIN=https://kukunisisi.co.ke

# Upload and logging
UPLOAD_DIR=/var/lib/kukunisisi/uploads
LOG_DIR=/var/log/kukunisisi

# Other recommended production settings
DB_SSL=false
